{
  "manifest_version": 3,
  "name": "Velocity Download Companion",
  "version": "0.4.0",
  "description": "Send supported video pages to the Velocity Download Manager.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Download with Velocity",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/velocity-32.png",
      "128": "icons/velocity-128.png"
    }
  },
  "icons": {
    "32": "icons/velocity-32.png",
    "128": "icons/velocity-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@velocity-download-manager.local",
      "strict_min_version": "121.0"
    }
  }
}
