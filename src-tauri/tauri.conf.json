{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocity",
  "version": "0.5.0",
  "identifier": "com.velocity.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Velocity Download Manager",
        "width": 1120,
        "height": 720,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["velocity"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMThFRDczRUExRTUxQzgKUldUSVVSN3FjKzBZTWVtb0lBbU5RV0NXVEY0eXdLS0hTMEQ4eFFXckI3b09GN0s1OEV6WTkwUGUK",
      "endpoints": [
        "https://github.com/mr-kasim-mehar/velocity-download-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["tools/*", "THIRD_PARTY_NOTICES.md", "browser-extension.zip"],
    "shortDescription": "Fast, resumable downloads for Windows and Linux",
    "longDescription": "Velocity is a modern cross-platform download manager with pause, resume, history, speed and ETA tracking.",
    "category": "Utility",
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "installMode": "currentUser" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
